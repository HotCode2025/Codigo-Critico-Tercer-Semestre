        app.processEvents()
        time.sleep(0.5)
        tiempo_espera += 0.5
    
    if splash_sync.isVisible():
        splash_sync.close()
        print("⚠️ Timeout: Forzando cierre del splash")
    
    print("✅ Splash de sincronización cerrado")

    # ============================================================
    # 6. INICIAR SINCRONIZACIÓN AUTOMÁTICA
    # ============================================================
