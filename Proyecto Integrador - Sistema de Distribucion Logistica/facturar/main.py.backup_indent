            painter.drawArc(centro_x - 130, centro_y - 130, 260, 260,
                          90 * 16, angulo_fin * 16)
            
            painter.setPen(Qt.PenStyle.NoPen)
            painter.setBrush(QBrush(QColor(76, 175, 80, 220)))
