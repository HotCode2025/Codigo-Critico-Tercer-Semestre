        iniciar_sincronizacion_auto(db_conn, intervalo=5)
        print("🔄 Sincronización automática iniciada (en segundo plano)")
    except Exception as e:
        print(f"⚠️ Error iniciando sincronización automática: {e}")
    
    db_conn.close()

