        painter.setPen(pen)
        painter.drawArc(centro_x - 210, centro_y - 210, 420, 420,
                       self.angulo * 16, 120 * 16)
        
        pen.setColor(QColor(33, 150, 243))
        painter.setPen(pen)
        painter.drawArc(centro_x - 190, centro_y - 190, 380, 380,
                       (360 - self.angulo) * 16, 90 * 16)
        
        pen.setColor(QColor(76, 175, 80))
        painter.setPen(pen)
        painter.drawArc(centro_x - 170, centro_y - 170, 340, 340,
                       (self.angulo + 180) * 16, 80 * 16)
        
        painter.setPen(Qt.PenStyle.NoPen)
        painter.setBrush(QBrush(QColor(255, 255, 255, 230)))
        painter.drawEllipse(centro_x - 55, centro_y - 65, 110, 110)
        
        painter.setBrush(QBrush(QColor(33, 150, 243, 200)))
        painter.drawEllipse(centro_x - 30, centro_y - 40, 35, 26)
        painter.drawEllipse(centro_x + 8, centro_y - 45, 32, 28)
        painter.drawEllipse(centro_x - 15, centro_y - 52, 42, 30)
        painter.drawRoundedRect(centro_x - 38, centro_y - 30, 78, 26, 8, 8)
        
        pen.setWidth(4)
        pen.setColor(QColor(255, 193, 7))
        painter.setPen(pen)
        
        ang_flecha = math.radians(self.angulo)
        fx = centro_x + 30 * math.cos(ang_flecha)
        fy = centro_y - 15 + 30 * math.sin(ang_flecha)
        
        painter.drawLine(centro_x, centro_y - 15, int(fx), int(fy))
        painter.drawLine(int(fx), int(fy), int(fx - 8 * math.cos(ang_flecha - 0.5)), 
                        int(fy - 8 * math.sin(ang_flecha - 0.5)))
        painter.drawLine(int(fx), int(fy), int(fx - 8 * math.cos(ang_flecha + 0.5)), 
                        int(fy - 8 * math.sin(ang_flecha + 0.5)))
        
        painter.setPen(Qt.PenStyle.NoPen)
        painter.setBrush(QBrush(QColor(255, 255, 255, 200)))
        painter.drawRoundedRect(centro_x - 200, centro_y + 55, 400, 35, 10, 10)
        
        painter.setFont(QFont("Segoe UI", 15, QFont.Weight.Bold))
        painter.setPen(QPen(QColor(26, 35, 126)))
